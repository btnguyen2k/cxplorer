# CXplorer shared external identity-provider defaults. Commit this file.
# Never add credentials, API keys, client IDs, or private tenant identifiers here.
# Put private overrides in id_vendor.local.env (ignored) or environment variables.
# Priority: explicit settings > environment > local file > this file > defaults.
# Restart the application after changing identity-provider configuration.

# Microsoft Entra ID is currently the only implemented provider.
# MS_CLIENT_ID: application/client ID from the provider's app registration.
# MS_CLIENT_SECRET: client secret for that registration; never commit its value.
# Configure BOTH in the private local file or environment to enable sign-in.
# Missing or empty credentials disable sign-in; supplying only one is an error.
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Tenant/account audience:
# common = organizational and personal accounts;
# organizations = organizational accounts; consumers = personal accounts.
# A specific tenant UUID is also accepted, but belongs in a private override.
MS_TENANT=common
