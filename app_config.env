# CXplorer shared application defaults. This file belongs in version control.
# Keep secrets, API keys, private hostnames, and deployment-specific data out.
# Put private overrides in app_config.local.env (ignored) or environment variables.
# Priority: explicit settings > environment > local file > this file > defaults.
# Run from the repository root; restart the application after configuration changes.

# Display name used in page titles and navigation.
APP_NAME=CXplorer

# development, test, or production. Production enables secure cookies and hides
# API documentation by default unless the optional overrides below are supplied.
ENVIRONMENT=development

# Reload Python source changes during development. Does not watch dotenv files.
RELOAD=false

# Insights generation is enabled automatically when at least one AI vendor is configured.
# Vendor credentials belong in ai_vendors.local.env or the process environment.
# URL draft caching and restoration of valid saved reports do not require AI.
AI_VENDOR_CONFIG_FILE=ai_vendors.env
AI_TASK_CONFIG_FILE=ai_tasks.env

# Required secret: SESSION_SECRET must contain at least 32 characters.
# You can generate a secure secret with Python: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SESSION_SECRET="<remember to generate a secure secret for production>"

# Signed session lifetime in seconds: 300 minimum, 86400 maximum (default 8 hours).
SESSION_MAX_AGE_SECONDS=28800

# JSON array of accepted request hostnames. Keep only local development hosts here;
# supply deployment hosts through a private override instead.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Optional login allowlist. Use exact email addresses or whole-email '*' patterns.
# An unset, blank, or empty list allows every provider-validated email address.
# Examples: ["seller@contoso.com","*@contoso.com"]
LOGIN_ALLOWED_EMAILS=[]

# Optional SESSION_COOKIE_SECURE: true/false. Omitted by default so production
# requires HTTPS cookies and development/test allow local HTTP.
# Optional DOCS_ENABLED: true/false. Omitted by default so API documentation is
# available outside production only. Set overrides in the local file or environment.
