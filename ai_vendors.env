# AI provider connections. Shared defaults contain NO credentials or private deployment details.
# Loaded by AIVendorSettings(BaseSettings); override in ignored ai_vendors.local.env or
# CX_AI__<VENDOR>__<CONFIG> process environment variables.
# Precedence: constructor values > environment > local file > this file > typed defaults.
# Pydantic/python-dotenv handle nested values, source precedence, and dotenv interpolation.
# Generation is enabled automatically when at least one vendor has the configuration below.
#
# Both vendors use the official OpenAI Python SDK, AsyncOpenAI and the Responses API.
# Vendor keys are OPENAI / AZURE_OPENAI, with "__" separating every tree level.
# Task VENDOR values also accept Open AI, Open-AI, AzureOpenAI, Azure OpenAI, Azure-OpenAI,
# and underscore/case variants. Legacy single-separator vendor variable names are not loaded.
#
# Azure accepts the resource root or its already-normalized /openai/v1/ base URL.
# A Contoso example is https://contoso.openai.azure.com/openai/v1/ (not a real deployment).
# Endpoint must use HTTPS without credentials, query parameters, or deployment-specific paths.
CX_AI__AZURE_OPENAI__ENDPOINT=
# Azure is enabled when ENDPOINT is set and either API_KEY or all three Azure Identity
# process variables below are set. The signed-in website user's identity is never reused.
# AUTH_MODE is the preference when BOTH credential forms are present (default Entra ID).
# If only one credential form is configured, it is selected automatically.
# Async credentials are created lazily at the first request; interactive/brokered
# sign-in is disabled. Managed identity/workload identity or an operator-configured Azure
# identity must already have inference access. No application OAuth token is reused or saved.
# Async Azure Identity also requires an installed aiohttp transport dependency.
# https://github.com/Azure/azure-sdk-for-python/tree/main/sdk/identity/azure-identity#async-credentials
# Current Azure v1 Entra scope: https://ai.azure.com/.default.
# https://learn.microsoft.com/en-us/azure/foundry-classic/openai/how-to/switching-endpoints
CX_AI__AZURE_OPENAI__AUTH_MODE=entra_id
# Azure Identity discovers credentials itself through DefaultAzureCredential.
# For service-principal authentication, provide these standard PROCESS environment variables:
# AZURE_TENANT_ID=<directory-tenant-id>
# AZURE_CLIENT_ID=<application-client-id>
# AZURE_CLIENT_SECRET=<client-secret-value-not-secret-id>
# These examples are documentation only. Neither this file nor ai_vendors.local.env exports
# AZURE_* values into the process environment; CXplorer does not parse or pass them to Azure.
# The SDK owns authentication. A managed/workload/local session alone does not satisfy the
# application's explicit availability rule: an API key or all three process variables are needed.
# Never commit real identifiers or credentials, and never reuse website MS_* login secrets.
# Providing this key alone with ENDPOINT enables Azure API-key authentication.
# With both credential forms present, AUTH_MODE=api_key explicitly prefers the key.
CX_AI__AZURE_OPENAI__API_KEY=
# Connection/request ceilings per attempt, in seconds; both positive, connect <= request.
# The 600-second request default accommodates long-running reasoning model calls.
CX_AI__AZURE_OPENAI__CONNECT_TIMEOUT_SECONDS=10
CX_AI__AZURE_OPENAI__REQUEST_TIMEOUT_SECONDS=600
# Additional transient attempts (0..3), owned by TaskExecutor. SDK retries are ALWAYS zero.
CX_AI__AZURE_OPENAI__MAX_RETRIES=2
# Executor's aggregate per-vendor in-flight limit (1..16).
CX_AI__AZURE_OPENAI__MAX_CONCURRENCY=6

# Direct OpenAI is enabled by API_KEY alone; the SDK supplies its default endpoint.
CX_AI__OPENAI__AUTH_MODE=api_key
# Leave blank when unused; configure a non-placeholder key privately before routing tasks here.
CX_AI__OPENAI__API_KEY=
CX_AI__OPENAI__CONNECT_TIMEOUT_SECONDS=10
CX_AI__OPENAI__REQUEST_TIMEOUT_SECONDS=600
CX_AI__OPENAI__MAX_RETRIES=2
CX_AI__OPENAI__MAX_CONCURRENCY=6
# Optional private OpenAI organization/project identifiers; unsupported for Azure.
CX_AI__OPENAI__ORGANIZATION=
CX_AI__OPENAI__PROJECT=

# Enabled deployments must support Responses, strict structured output, and each configured
# model parameter. Unsupported capabilities fail explicitly; no weaker JSON/prose fallback.
# Azure documents 100 object properties/five schema nesting levels, with references and
# recursive schemas supported. Its native validator decides deployment-specific compatibility;
# the adapter does not invent a nesting-count algorithm by expanding every reference.
# https://learn.microsoft.com/en-us/azure/foundry/openai/how-to/structured-outputs
# Current Azure and OpenAI both support web_search with native filters.allowed_domains.
# https://learn.microsoft.com/en-us/azure/foundry/openai/how-to/web-search
# https://developers.openai.com/api/docs/guides/tools-web-search
# Native filtering includes subdomains; exact approved-host checks remain mandatory locally.
# Azure search uses Bing's indexed results, NOT live external web access. Results may lag.
# Azure web search is separately billed, may be subscription-blocked, and Bing processing
# has its own terms/compliance boundary. store=false is not a zero-retention guarantee.
