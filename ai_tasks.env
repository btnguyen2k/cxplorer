# Task routing and bounded, stateless pipeline settings. No credentials belong in this file.
# Override in ignored ai_tasks.local.env or CX_AI_* process environment variables.
# AITaskSettings(BaseSettings) loads the CX_AI_TASK and CX_AI_PIPELINE trees using "__".
# Constructor > environment > local file > this file > typed defaults; unrelated roots are ignored.
# The seven task IDs below are the fixed registry. Nested task/vendor/field names are validated.
# Vendor spelling is case-insensitive; every default task routes to AzureOpenAI.
# MODEL labels below are suggested MODEL FAMILIES, not evidence of an available deployment.
# Operators MUST replace them with their actual supported Azure deployment IDs privately.
# PROMPT_VERSION currently supports only v1.
# REASONING_EFFORT supports only low/medium/high, case-insensitive (e.g. High is accepted).
# Each actual deployment must support its supplied reasoning/optional TEMPERATURE settings;
# these are sent as configured, never silently dropped after a provider rejection.
# MAX_INPUT_TOKENS includes instructions, schema and evidence; hosted-search usage is uncertain.
# MAX_OUTPUT_TOKENS includes reasoning where billed. Every attempt consumes job budgets.
# TIMEOUT_SECONDS is the whole-task deadline across attempts, additionally bounded by the
# 900-second job deadline. The 600-second defaults allow one long-running model attempt.
# USE_WEB_SEARCH accepts true/false (case-insensitive), 1/0, yes/no, on/off.
# MAX_TOOL_CALLS is 0..25, and must be positive when search is enabled.
# The executor also caps hosted tool calls at 75 per job, counting retry attempts.
# There is no job-wide tool-call configuration override.

CX_AI_TASK__VERIFY_SOURCES__VENDOR=AzureOpenAI
CX_AI_TASK__VERIFY_SOURCES__MODEL=gpt-5.6-sol
CX_AI_TASK__VERIFY_SOURCES__PROMPT_VERSION=v1
CX_AI_TASK__VERIFY_SOURCES__REASONING_EFFORT=low
CX_AI_TASK__VERIFY_SOURCES__USE_WEB_SEARCH=false
CX_AI_TASK__VERIFY_SOURCES__MAX_TOOL_CALLS=0
CX_AI_TASK__VERIFY_SOURCES__MAX_INPUT_TOKENS=12000
CX_AI_TASK__VERIFY_SOURCES__MAX_OUTPUT_TOKENS=2500
CX_AI_TASK__VERIFY_SOURCES__TIMEOUT_SECONDS=600

# Mandatory official company/executive announcements in the last 90 days; no opt-out.
# This is the ONLY task with web search on by default. Search always requires the supplied
# approved official hosts, native domain filters and a final exact-host/publication-date gate.
# No general-news expansion or unofficial search service fallback is permitted.
CX_AI_TASK__DISCOVER_NEWS__VENDOR=AzureOpenAI
CX_AI_TASK__DISCOVER_NEWS__MODEL=gpt-5.6-sol
CX_AI_TASK__DISCOVER_NEWS__PROMPT_VERSION=v1
CX_AI_TASK__DISCOVER_NEWS__REASONING_EFFORT=medium
CX_AI_TASK__DISCOVER_NEWS__USE_WEB_SEARCH=true
CX_AI_TASK__DISCOVER_NEWS__MAX_TOOL_CALLS=25
CX_AI_TASK__DISCOVER_NEWS__MAX_INPUT_TOKENS=32000
CX_AI_TASK__DISCOVER_NEWS__MAX_OUTPUT_TOKENS=6000
CX_AI_TASK__DISCOVER_NEWS__TIMEOUT_SECONDS=600

CX_AI_TASK__EXTRACT_EVIDENCE__VENDOR=AzureOpenAI
CX_AI_TASK__EXTRACT_EVIDENCE__MODEL=gpt-5.6-luna
CX_AI_TASK__EXTRACT_EVIDENCE__PROMPT_VERSION=v1
CX_AI_TASK__EXTRACT_EVIDENCE__REASONING_EFFORT=low
CX_AI_TASK__EXTRACT_EVIDENCE__USE_WEB_SEARCH=false
CX_AI_TASK__EXTRACT_EVIDENCE__MAX_TOOL_CALLS=0
CX_AI_TASK__EXTRACT_EVIDENCE__MAX_INPUT_TOKENS=12000
CX_AI_TASK__EXTRACT_EVIDENCE__MAX_OUTPUT_TOKENS=4000
CX_AI_TASK__EXTRACT_EVIDENCE__TIMEOUT_SECONDS=600

CX_AI_TASK__CONSOLIDATE_EVIDENCE__VENDOR=AzureOpenAI
CX_AI_TASK__CONSOLIDATE_EVIDENCE__MODEL=gpt-5.6-terra
CX_AI_TASK__CONSOLIDATE_EVIDENCE__PROMPT_VERSION=v1
CX_AI_TASK__CONSOLIDATE_EVIDENCE__REASONING_EFFORT=medium
CX_AI_TASK__CONSOLIDATE_EVIDENCE__USE_WEB_SEARCH=false
CX_AI_TASK__CONSOLIDATE_EVIDENCE__MAX_TOOL_CALLS=0
CX_AI_TASK__CONSOLIDATE_EVIDENCE__MAX_INPUT_TOKENS=30000
CX_AI_TASK__CONSOLIDATE_EVIDENCE__MAX_OUTPUT_TOKENS=6000
CX_AI_TASK__CONSOLIDATE_EVIDENCE__TIMEOUT_SECONDS=600

CX_AI_TASK__SYNTHESIZE_STRATEGY__VENDOR=AzureOpenAI
CX_AI_TASK__SYNTHESIZE_STRATEGY__MODEL=gpt-5.6-terra
CX_AI_TASK__SYNTHESIZE_STRATEGY__PROMPT_VERSION=v1
CX_AI_TASK__SYNTHESIZE_STRATEGY__REASONING_EFFORT=high
CX_AI_TASK__SYNTHESIZE_STRATEGY__USE_WEB_SEARCH=false
CX_AI_TASK__SYNTHESIZE_STRATEGY__MAX_TOOL_CALLS=0
CX_AI_TASK__SYNTHESIZE_STRATEGY__MAX_INPUT_TOKENS=24000
CX_AI_TASK__SYNTHESIZE_STRATEGY__MAX_OUTPUT_TOKENS=8000
CX_AI_TASK__SYNTHESIZE_STRATEGY__TIMEOUT_SECONDS=600

CX_AI_TASK__GENERATE_TALK_POINTS__VENDOR=AzureOpenAI
CX_AI_TASK__GENERATE_TALK_POINTS__MODEL=gpt-5.6-sol
CX_AI_TASK__GENERATE_TALK_POINTS__PROMPT_VERSION=v1
CX_AI_TASK__GENERATE_TALK_POINTS__REASONING_EFFORT=medium
CX_AI_TASK__GENERATE_TALK_POINTS__USE_WEB_SEARCH=false
CX_AI_TASK__GENERATE_TALK_POINTS__MAX_TOOL_CALLS=0
CX_AI_TASK__GENERATE_TALK_POINTS__MAX_INPUT_TOKENS=14000
CX_AI_TASK__GENERATE_TALK_POINTS__MAX_OUTPUT_TOKENS=4500
CX_AI_TASK__GENERATE_TALK_POINTS__TIMEOUT_SECONDS=600

CX_AI_TASK__REVIEW_REPORT__VENDOR=AzureOpenAI
CX_AI_TASK__REVIEW_REPORT__MODEL=gpt-5.6-terra
CX_AI_TASK__REVIEW_REPORT__PROMPT_VERSION=v1
CX_AI_TASK__REVIEW_REPORT__REASONING_EFFORT=high
CX_AI_TASK__REVIEW_REPORT__USE_WEB_SEARCH=false
CX_AI_TASK__REVIEW_REPORT__MAX_TOOL_CALLS=0
CX_AI_TASK__REVIEW_REPORT__MAX_INPUT_TOKENS=32000
CX_AI_TASK__REVIEW_REPORT__MAX_OUTPUT_TOKENS=6000
CX_AI_TASK__REVIEW_REPORT__TIMEOUT_SECONDS=600

# Operational options: temporary in-memory jobs/results only; no database or report storage.
# Nonempty, unique subset of ceo/cto/cio/cfo/ciso. Points per audience: 1..5.
CX_AI_PIPELINE__DEFAULT_AUDIENCES=ceo,cto,cio,cfo,ciso
CX_AI_PIPELINE__TALK_POINTS_PER_AUDIENCE=3
# Collection capacities: seeds 1..6, documents 1..12; document capacity must cover all seeds.
CX_AI_PIPELINE__MAX_SEED_URLS=6
CX_AI_PIPELINE__MAX_FETCHED_PAGES=12
# Concurrent work: fetch/extraction 1..8, audience generation 1..5; vendor limits also apply.
CX_AI_PIPELINE__FETCH_CONCURRENCY=4
CX_AI_PIPELINE__EXTRACTION_CONCURRENCY=4
CX_AI_PIPELINE__AUDIENCE_CONCURRENCY=3
# Source deadline >0..20 seconds; redirects 0..3, with each hop independently authorized.
CX_AI_PIPELINE__FETCH_TIMEOUT_SECONDS=20
CX_AI_PIPELINE__MAX_REDIRECTS=3
# Hard safety ceilings: 2 MiB decompressed HTML, 15 MiB PDF, 200 PDF pages (may be lowered).
CX_AI_PIPELINE__MAX_HTML_BYTES=2097152
CX_AI_PIPELINE__MAX_PDF_BYTES=15728640
CX_AI_PIPELINE__MAX_PDF_PAGES=200
# Admission limits: per-user 1..4, running 1..4, queued 0..16, scoped to this process.
CX_AI_PIPELINE__MAX_ACTIVE_JOBS_PER_USER=1
CX_AI_PIPELINE__MAX_RUNNING_JOBS=2
CX_AI_PIPELINE__MAX_QUEUED_JOBS=4
# Job call limit 1..40 counts every attempt, including repairs and reviews.
CX_AI_PIPELINE__MAX_MODEL_CALLS=40
# Hard aggregate job token ceilings: input 1..300000, output 1..120000.
CX_AI_PIPELINE__MAX_TOTAL_INPUT_TOKENS=300000
CX_AI_PIPELINE__MAX_TOTAL_OUTPUT_TOKENS=120000
# Repair rounds 0..1, then another review at most; hard job deadline >0..900 seconds.
CX_AI_PIPELINE__MAX_REPAIR_ROUNDS=1
CX_AI_PIPELINE__JOB_TIMEOUT_SECONDS=900
# News window is fixed at 90 days. Article cap 1..3; explicit evidence gaps replace padding.
CX_AI_PIPELINE__NEWS_DAYS=90
CX_AI_PIPELINE__MAX_NEWS_ARTICLES=3
# Transient result TTL 60..86400 seconds and bounded result count 1..16; no persisted reports.
CX_AI_PIPELINE__RESULT_TTL_SECONDS=3600
CX_AI_PIPELINE__MAX_RESULTS=16
# Deterministic tokenizer estimator: o200k_base (or cl100k_base for a verified deployment).
# Model/deployment names are NOT tokenizer names. Verify compatibility when switching models.
# Encoding assets should be pre-cached for offline production; unit tests inject a tokenizer.
# Multiplier 1.1..3 plus fixed framing overhead is conservative, not an exact universal bound.
# Hosted search adds unpredictable input; reserve its full task input cap and reconcile usage.
CX_AI_PIPELINE__TOKENIZER_ENCODING=o200k_base
CX_AI_PIPELINE__TOKEN_ESTIMATE_MULTIPLIER=1.25
